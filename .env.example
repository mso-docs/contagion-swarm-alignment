# One-time setup: cp .env.example .env
# Edit .env, then run: .venv/bin/python scripts/run_pilot.py --export-dashboard
# .env is git-ignored. Keep actual server addresses and secrets there.
# This script loads .env as data; existing shell variables take precedence.
# Values may be quoted; inline comments are supported. No variable expansion.

# Inference backend: ollama (native), openai (compatible), or mock (no server).
CONTAGION_PROVIDER=ollama

# REQUIRED for live inference: operator-approved existing server URL.
# Native Ollama: http://<host>:<port> (normally port 11434).
# OpenAI-compatible local server: http://<host>:<port>/v1.
# Leave blank until you know the address; the script does not configure servers.
CONTAGION_BASE_URL=

# REQUIRED for live pilot: exact installed model tag, never auto-downloaded.
# Set BASE_URL first, run the command below, then copy a listed tag here:
# .venv/bin/python scripts/run_pilot.py --doctor-only
CONTAGION_MODEL=

# Optional endpoint authentication; usually blank for local Ollama.
# Sent only in the Authorization header; not printed or recorded.
CONTAGION_API_KEY=

# Paired clean/injected RQ1 config. Research parameters (rounds, seed,
# temperature, token/call/time limits, topology) live in this YAML file.
# Protocol 1.1 explicitly disables thinking via native Ollama.
# For OpenAI-compatible servers, use configs/rq1_pair.yaml (backend default).
# Keep the pair here until the live pilot has been reviewed.
CONTAGION_PILOT_CONFIG=configs/rq1_pair_thinking_disabled.yaml

# Optional output directory, relative to the repository or absolute.
# Blank selects results/<provider>-pilot, separating mock and live backends.
# Reuse to resume verified runs; use a new folder for a new model/protocol.
CONTAGION_RESULTS_DIR=

# Optional second inference server: copy this template to .env.secondary, then
# configure that file independently. Both private files stay git-ignored.
# Study/reviewer CLI: --env-file .env.secondary
# Keep each run on one server. Match exact model digests for shared cohorts.
# No automatic failover, model pulls, service edits or networking changes.

# Optional remote worker setup; existing SSH alias or user@host. No passwords.
PRIMARY_SERVER_ID=
SECONDARY_SERVER_ID=
# Absolute paths or ~/... ; setup uses a fresh release subdirectory here.
PRIMARY_PROJECT_DIR=
SECONDARY_PROJECT_DIR=

# Optional frontier judge: put its CONTAGION_API_KEY in ignored .env.judge.
# Keep cloud-only variables out of this strict local-worker configuration.
# See docs/FRONTIER_REVIEW.md for the separate judge environment and $20 ledger.
